  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Register a user. Omit invite_code to create a new family, or supply an existing family UUID to join it.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Morgan\",\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"family_name\": \"Morgan Family\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const response = pm.response.json();",
                  "  const payload = response.data || {};",
                  "  if (payload.access_token) pm.collectionVariables.set('token', payload.access_token);",
                  "  const family = payload.user && payload.user.family;",
                  "  if (family && family.id) pm.collectionVariables.set('familyId', family.id);",
                  "  const families = payload.families || [];",
                  "  if (!pm.collectionVariables.get('familyId') && families.length && families[0].id) pm.collectionVariables.set('familyId', families[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Login and automatically save data.access_token and a familyId when available.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex@example.com\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code >= 200 && pm.response.code < 300) {",
                  "  const response = pm.response.json();",
                  "  const payload = response.data || {};",
                  "  if (payload.access_token) pm.collectionVariables.set('token', payload.access_token);",
                  "  const family = payload.user && payload.user.family;",
                  "  if (family && family.id) pm.collectionVariables.set('familyId', family.id);",
                  "  const families = payload.families || [];",
                  "  if (!pm.collectionVariables.get('familyId') && families.length && families[0].id) pm.collectionVariables.set('familyId', families[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
